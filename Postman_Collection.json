{
  "info": {
    "name": "Inmobiliaria API - Imágenes de Propiedades",
    "description": "Endpoints para gestión de imágenes con Cloudflare R2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Imágenes - Get",
      "item": [
        {
          "name": "Listar Imágenes (Paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/imagenpropiedad?page=1&pageSize=10",
              "host": ["{{base_url}}"],
              "path": ["api", "imagenpropiedad"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "10"
                },
                {
                  "key": "propiedadId",
                  "value": "",
                  "disabled": true
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Imágenes de Propiedad Específica",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/imagenpropiedad/propiedad/1",
              "host": ["{{base_url}}"],
              "path": ["api", "imagenpropiedad", "propiedad", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Obtener Imagen por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/imagenpropiedad/1",
              "host": ["{{base_url}}"],
              "path": ["api", "imagenpropiedad", "1"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Imágenes - Post",
      "item": [
        {
          "name": "Subir Imagen (Archivo)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "IdPropiedad",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "Archivo",
                  "type": "file",
                  "src": ""
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/imagenpropiedad/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "imagenpropiedad", "upload"]
            }
          },
          "response": []
        },
        {
          "name": "Crear Imagen (URL Externa)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idPropiedad\": 1,\n  \"url\": \"https://example.com/imagen.jpg\",\n  \"orden\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/imagenpropiedad",
              "host": ["{{base_url}}"],
              "path": ["api", "imagenpropiedad"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Imágenes - Put",
      "item": [
        {
          "name": "Actualizar Imagen",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"url\": \"https://example.com/nueva-imagen.jpg\",\n  \"orden\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/imagenpropiedad/1",
              "host": ["{{base_url}}"],
              "path": ["api", "imagenpropiedad", "1"]
            }
          },
          "response": []
        },
        {
          "name": "Marcar como Principal",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/imagenpropiedad/1/hacer-principal",
              "host": ["{{base_url}}"],
              "path": ["api", "imagenpropiedad", "1", "hacer-principal"]
            }
          },
          "response": []
        },
        {
          "name": "Reordenar Imágenes",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[1, 3, 2]"
            },
            "url": {
              "raw": "{{base_url}}/api/imagenpropiedad/propiedad/1/reordenar",
              "host": ["{{base_url}}"],
              "path": ["api", "imagenpropiedad", "propiedad", "1", "reordenar"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Imágenes - Delete",
      "item": [
        {
          "name": "Eliminar Imagen",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/imagenpropiedad/1",
              "host": ["{{base_url}}"],
              "path": ["api", "imagenpropiedad", "1"]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:2000",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ]
}
